/*****************************************************************************
* SW Matrix Multiply divide by 256 fn
******************************************************************************/
void matrix_multiply_neuron(int num_rows, int num_cols, int* weight_vector, int* result_vector) {
// Get the starting index in the input memory

	// Perform matrix multiplication: C = A * B (ROWA x 1 result)
	#ifdef ENABLE_AXI_TIMER
    u32 start_time, end_time, elapsed_time;
	double elapsed_time_sec;
	// Start the Timer
	XTmrCtr_Reset(&TimerCounter, TIMER_COUNTER_0);
	XTmrCtr_Start(&TimerCounter, TIMER_COUNTER_0);
	start_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
	#endif
	for (int test_index = 0; test_index < num_rows; test_index++) { //for each test case
		for (int j = 0; j < NUM_NEURONS; j++) { //for each neuron
			int sum = 0;
			int round_up = 0;
			for (int k = 0; k < num_cols; k++) { //each column
				sum += test_input_memory[test_index * num_cols + k] *
						weight_vector[k + j * num_cols];
			}
			if (sum & 0x80) {
				round_up = 1;  // Round up by adding 1
			}
			result_vector[j + test_index * NUM_NEURONS] = activ_func_sigmoid[((sum >> 8) & 0xFF) + round_up  - 1];
		}
	}
	#ifdef ENABLE_AXI_TIMER
	end_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
	XTmrCtr_Stop(&TimerCounter, TIMER_COUNTER_0);
	// Calculate elapsed time
	elapsed_time = end_time - start_time;;
	elapsed_time_sec = (double)elapsed_time / CLOCK_FREQ_HZ;
	xil_printf("Execution time for %s: %u clock cycles (~%.6f sec)\r\n", "ARM Processor SW", elapsed_time, elapsed_time_sec);
	#endif
}

void matrix_multiply_result(int num_rows, int num_cols, int* weight_vector, int* result_vector) {


	// Perform matrix multiplication: C = A * B (ROWA x 1 result)
	#ifdef ENABLE_AXI_TIMER
    u32 start_time, end_time, elapsed_time;
	double elapsed_time_sec;
	// Start the Timer
	XTmrCtr_Reset(&TimerCounter, TIMER_COUNTER_0);
	XTmrCtr_Start(&TimerCounter, TIMER_COUNTER_0);
	start_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
	#endif

	for (int test_index = 0; test_index < num_rows; test_index++) {
		int round_up = 0;
		int sum = neuron_result_memory[test_index * NUM_NEURONS] * weight_vector[NUM_NEURONS * NUMBER_OF_INPUT_WORDS + 1]
				+ neuron_result_memory[test_index * NUM_NEURONS + 1] * weight_vector[NUM_NEURONS * NUMBER_OF_INPUT_WORDS + 2];
		if (sum & 0x80) {
			round_up = 1;  // Round up by adding 1
		}
		result_vector[test_index] = (weight_vector[NUM_NEURONS * NUMBER_OF_INPUT_WORDS] + (sum >> 8) + round_up) & 0xFF;
		xil_printf("%d\r\n", result_vector[test_index]);
	}
	#ifdef ENABLE_AXI_TIMER
	end_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
	XTmrCtr_Stop(&TimerCounter, TIMER_COUNTER_0);
	// Calculate elapsed time
	elapsed_time = end_time - start_time;;
	elapsed_time_sec = (double)elapsed_time / CLOCK_FREQ_HZ;
	xil_printf("Execution time for %s: %u clock cycles (~%.6f sec)\r\n", "ARM Processor SW", elapsed_time, elapsed_time_sec);
	#endif
}

/*****************************************************************************
* Read and store data
******************************************************************************/
void readInHexData(int totalWords, int* vector_input_memory) {
    char RecvChar;
    uint8_t currentByte = 0;
    int currentByteIndex = 0;
    int currentWordIndex = 0;

    while (1) {
    	if(currentWordIndex % 8 ==0){
    		vector_input_memory[currentWordIndex] = 255; // for bias
    		currentWordIndex++;
    		continue;
    	}
        // Read the character input
        scanf("%c", &RecvChar);

        // If the character is a valid hexadecimal digit
        if ((RecvChar >= '0' && RecvChar <= '9') || (RecvChar >= 'A' && RecvChar <= 'F') || (RecvChar >= 'a' && RecvChar <= 'f')) {
            // Convert hex char to its integer value and update the current byte
            if (RecvChar >= '0' && RecvChar <= '9') {
                currentByte = (currentByte << 4) | (RecvChar - '0');  // Left shift and OR with the hex value
            } else if (RecvChar >= 'A' && RecvChar <= 'F') {
                currentByte = (currentByte << 4) | (RecvChar - 'A' + 10);
            } else if (RecvChar >= 'a' && RecvChar <= 'f') {
                currentByte = (currentByte << 4) | (RecvChar - 'a' + 10);
            }

            currentByteIndex++;

            // After two hex characters (one byte), store it in the memory
            if (currentByteIndex == 2) {
                if (currentWordIndex < totalWords) {
                    vector_input_memory[currentWordIndex] = currentByte;
                    #ifdef ENABLE_PRINT_STATEMENTS
                    xil_printf("Storing %d in test_input_memory[%d]\n", currentByte, currentWordIndex);
                    #endif
                    currentWordIndex++;
                    if (currentWordIndex == totalWords) {
                        break;
                    }
                }
                // Reset for the next byte
                currentByte = 0;
                currentByteIndex = 0;
            }
        }
    }
}

/*****************************************************************************
* Main function
******************************************************************************/
int main()
{
	int Status = XST_SUCCESS;
	//, test_case_cnt = 0;

	XTmrCtr *TmrCtrInstancePtr = &TimerCounter;
	int success;

	/************************** Initializations *****************************/
//	XLlFifo_Config *Config;
	/*
	 * Perform a self-test to ensure that the hardware was built
	 * correctly, use the 1st timer in the device (0)
	 */
	Status = XTmrCtr_Initialize(TmrCtrInstancePtr, XPAR_TMRCTR_0_DEVICE_ID);
	if (Status != XST_SUCCESS) {
	    xil_printf("Timer initialization failed!\n");
	    return XST_FAILURE;
	}
	/************** Run a software version of the hardware function to validate results ************/
	// instead of hard-coding the results in test_result_expected_memory
	xil_printf("Reading Data ");
	readInHexData(NUMBER_OF_TEST_VECTORS * NUMBER_OF_INPUT_WORDS, &test_input_memory[0]);
	readInHexData(NUMBER_OF_TEST_VECTORS * NUMBER_OF_OUTPUT_WORDS, &test_result_expected_memory[0]);
	xil_printf("Finish Reading Data ");
	/**************************  SW Calculate Results for all test vectors *****************************/
	matrix_multiply_neuron(ROWA, COLA, &weight_vector_full[0], &neuron_result_memory[0]);
	matrix_multiply_result(ROWA, NUM_NEURONS, &weight_vector_full[0], &result_memory[0]);
	/************************** Checking correctness of results *****************************/

	success = 1;

	/* Compare the data send with the data received */
//	xil_printf(" Comparing data ...\r\n");
	for (int word_cnt = 0; word_cnt < NUMBER_OF_TEST_VECTORS * NUMBER_OF_OUTPUT_WORDS; word_cnt++) {
		success = success & (result_memory[word_cnt] == test_result_expected_memory[word_cnt]);
		#ifdef ENABLE_PRINT_STATEMENTS
		xil_printf("Result: %d\n", result_memory[word_cnt]);
		if (result_memory[word_cnt] != test_result_expected_memory[word_cnt]) {
			xil_printf("Mismatch at index %d: Expected %d, Got %d\n", word_cnt, test_result_expected_memory[word_cnt], result_memory[word_cnt]);
		}
		#endif
	}

	if (success != 1){
		xil_printf("Test Failed\r\n");
		return XST_FAILURE;
	}

	xil_printf("Test Success\r\n");

	return XST_SUCCESS;
}





