/*****************************************************************************
* SW Matrix Multiply divide by 256 fn
******************************************************************************/
void matrix_multiply_sw(int test_vector_index) {
// Get the starting index in the input memory
	int input_offset = test_vector_index * NUMBER_OF_INPUT_WORDS;
	int output_offset = test_vector_index * NUMBER_OF_OUTPUT_WORDS;

	// Perform matrix multiplication: C = A * B (ROWA x 1 result)
	#ifdef ENABLE_AXI_TIMER
    u32 start_time, end_time, elapsed_time;
	double elapsed_time_sec;
	// Start the Timer
	XTmrCtr_Reset(&TimerCounter, TIMER_COUNTER_0);
	XTmrCtr_Start(&TimerCounter, TIMER_COUNTER_0);
	start_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
	#endif

	for (int i = 0; i < ROWA; i++) {
		int sum = 0;
		for (int j = 0; j < COLA; j++) {
			sum += test_input_memory[input_offset + i * COLA + j] *
				   test_input_memory[input_offset + (ROWA * COLA) + j];
		}
		test_result_expected_memory[output_offset + i] = (sum >> 8) & 0xFF;
	}
	#ifdef ENABLE_AXI_TIMER
	end_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
	XTmrCtr_Stop(&TimerCounter, TIMER_COUNTER_0);
	// Calculate elapsed time
	elapsed_time = end_time - start_time;;
	elapsed_time_sec = (double)elapsed_time / CLOCK_FREQ_HZ;
	xil_printf("Execution time for %s: %u clock cycles (~%.6f sec)\r\n", "ARM Processor SW", elapsed_time, elapsed_time_sec);
	#endif
}

/*****************************************************************************
* Initialise FIFO instances
******************************************************************************/
int InitFifoInstance(XLlFifo *InstancePtr, u16 DeviceId) {
    XLlFifo_Config *Config;
    int Status;

    // Lookup the configuration for the given device ID
    Config = XLlFfio_LookupConfig(DeviceId);
    if (!Config) {
        xil_printf("No config found for %d\r\n", DeviceId);
        return XST_FAILURE;
    }

    // Initialize the FIFO with the configuration
    Status = XLlFifo_CfgInitialize(InstancePtr, Config, Config->BaseAddress);
    if (Status != XST_SUCCESS) {
        xil_printf("Initialization failed for Device ID %d\r\n", DeviceId);
        return XST_FAILURE;
    }

    // Check for the Reset value
    Status = XLlFifo_Status(InstancePtr);
    XLlFifo_IntClear(InstancePtr, 0xffffffff); // Clear any interrupts

    // Verify the FIFO status after reset
    Status = XLlFifo_Status(InstancePtr);
    if (Status != 0x0) {
        xil_printf("\nERROR: Reset value of ISR0: 0x%x. Expected: 0x0\r\n", Status);
        return XST_FAILURE;
    }

    return XST_SUCCESS;
}

/*****************************************************************************
* Send and Receive FIFO Data
******************************************************************************/
int ProcessFifoData(XLlFifo *TxInstancePtr, XLlFifo *RxInstancePtr,
                    int *test_input_memory, int *result_memory,
                    int num_test_vectors, int num_input_words,
                    int num_output_words, int timeout_value, const char *test_name)
{
    int test_case_cnt, word_cnt;
    int Status;

	#ifdef ENABLE_AXI_TIMER
    u32 start_time, end_time, elapsed_time;
	double elapsed_time_sec;
	// Start the Timer
	XTmrCtr_Reset(&TimerCounter, TIMER_COUNTER_0);
	XTmrCtr_Start(&TimerCounter, TIMER_COUNTER_0);
	start_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
	#endif

    for (test_case_cnt = 0; test_case_cnt < num_test_vectors; test_case_cnt++) {

        /******************** Input to Coprocessor : Transmit the Data Stream ***********************/
		#if defined(ENABLE_PRINT_STATEMENTS) || !defined(ENABLE_TCL_PROFILER)
    	xil_printf("Transmitting Data for test case %d ... \r\n", test_case_cnt);
		#endif
        /* Writing into the FIFO Transmit Port Buffer */
        for (word_cnt = 0; word_cnt < num_input_words; word_cnt++) {
//            if (XLlFifo_iTxVacancy(TxInstancePtr)) {
                XLlFifo_TxPutWord(TxInstancePtr, test_input_memory[word_cnt + test_case_cnt * num_input_words]);
//            }
        }

        /* Start Transmission by writing transmission length (number of bytes = 4* number of words) into the TLR */
        XLlFifo_iTxSetLen(TxInstancePtr, num_input_words * 4);

        /* Check for Transmission completion */
        while (!(XLlFifo_IsTxDone(TxInstancePtr))) {
            // Optionally add a timeout check if needed
        }
        /* Transmission Complete */

        /******************** Output from Coprocessor : Receive the Data Stream ***********************/
		#if defined(ENABLE_PRINT_STATEMENTS) || !defined(ENABLE_TCL_PROFILER)
        xil_printf("Receiving data for test case %d ... \r\n", test_case_cnt);
		#endif
        int timeout_count = timeout_value;
        // wait for coprocessor to send data, subject to a timeout
        while (!XLlFifo_iRxOccupancy(RxInstancePtr)) {
            timeout_count--;
            if (timeout_count == 0) {
                xil_printf("Timeout while waiting for data ... \r\n");
                return XST_FAILURE;
            }
        }

        // we are expecting only one packet of data per test case
        u32 ReceiveLength = XLlFifo_iRxGetLen(RxInstancePtr) / 4;
        for (word_cnt = 0; word_cnt < ReceiveLength; word_cnt++) {
            // read one word at a time
            result_memory[word_cnt + test_case_cnt * num_output_words] = XLlFifo_RxGetWord(RxInstancePtr);
        }

		#ifdef ENABLE_AXI_TIMER
        end_time = XTmrCtr_GetValue(&TimerCounter, TIMER_COUNTER_0);
		XTmrCtr_Stop(&TimerCounter, TIMER_COUNTER_0);
		// Calculate elapsed time
		elapsed_time = end_time - start_time;;
		elapsed_time_sec = (double)elapsed_time / CLOCK_FREQ_HZ;
		xil_printf("Execution time for %s: %u clock cycles (~%.6f sec)\r\n", test_name, elapsed_time, elapsed_time_sec);
		#endif

        Status = XLlFifo_IsRxDone(RxInstancePtr);
        if (Status != TRUE) {
            xil_printf("Failing in receive complete ... \r\n");
            return XST_FAILURE;
        }
        /* Reception Complete */
    }

    return XST_SUCCESS;
}
